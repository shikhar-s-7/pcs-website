# Copy to .env.local for local work. On Vercel, add these in Project Settings -> Environment Variables.
# Every variable is optional. The site builds and renders without them.

# Contact form POST target (for example a FormSubmit, Formspree or own endpoint).
# Empty: the form shows "not accepting submissions" and the button is disabled.
NEXT_PUBLIC_ENQUIRY_ENDPOINT=https://example.com/your-form-endpoint

# Canonical site URL. Used for metadataBase, Open Graph, sitemap and robots.
# Default: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://your-site.example.com

# "true" lets search engines index the site. Anything else (default): noindex, nofollow, robots disallow all.
NEXT_PUBLIC_ALLOW_INDEXING=false
